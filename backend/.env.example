# API Keys for LLM Providers
# You only need to set keys for the providers you want to use in src/config.ts

# OpenAI (gpt-4o, gpt-4o-mini, etc.)
OPENAI_API_KEY=your_openai_key_here

# Anthropic (claude-sonnet-4.5, claude-opus-4, etc.)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google (gemini-2.0-flash-exp, gemini-pro, etc.)
GOOGLE_API_KEY=your_google_key_here

# OpenRouter (access to 300+ models from multiple providers)
OPENROUTER_API_KEY=your_openrouter_key_here

# Server Configuration
PORT=8001
